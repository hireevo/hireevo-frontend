# The API's origin, with no path: the generated client's paths already carry
# `/api/v1`, which comes from the published contract rather than from here.
NEXT_PUBLIC_API_URL=http://localhost:3000

# This app's own public origin. Canonical URLs, the sitemap and Open Graph tags
# are absolute, so this must match how the site is actually served.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# The local mail catcher's inbox. Development sends real mail by default, so
# "check your email" is simply true and this stays unset. Set it only when the
# API points SMTP at the catcher (`pnpm mail:up` in hireevo-backend): the screens
# that say "check your email" then link here, because the message went to the
# catcher rather than to the address that was typed. Never set it in production.
# NEXT_PUBLIC_DEV_MAILBOX_URL=http://localhost:8025

# Google reCAPTCHA v3 site key. Leave unset to run without bot protection
# (local, CI). Set it in production alongside RECAPTCHA_SECRET in the API. The
# key is public by design — it is embedded in the page.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
